workspace-7b253a6e-859b-4c52-8b39-e49439c9e4b4 (1)/

# Deploy credentials (server, DB, NEXTAUTH_SECRET) -- never commit
deploy_config.json

# Local data and scratch output -- never commit (DB dumps hold password hashes and customer rows)
/*.sql
/db/
/tool-results/
/.zscripts-backup/
*.pid

# Files that hold real credentials (live login, local DB password) -- keep local only
/worklog.md
/tests/live/
/playwright.live.config.ts
