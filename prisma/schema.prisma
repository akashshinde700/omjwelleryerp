// ───────────────────────── Bank Reconciliation ─────────────────────────
// be-platform-data. oMunim's own BANK REC is a filtered per-account ledger view (Start Date, End
// Date, Select Bank, Select Format = Bank View | Normal View | Cr Wise | Dr Wise) — not a statement
// matcher. Named bank accounts are the prerequisite for that (a firm has several; every bank leg
// must say which one). Beyond parity: BankTransaction gives a cheque a clearing date distinct from
// its transaction date (in transit until it clears — see `status`, and reversible on bounce via
// reverseVoucher(), never an edit of the posted voucher), and BankStatementLine is a CSV bank
// statement import that can be matched against the ledger without ever touching a posted
// LedgerEntry — reconciliation is metadata on the imported row, not a mutation of the books.
//
// Known limitation, out of this task's reach: the EXISTING cheque/card/UPI legs posted by
// src/app/api/invoices/**, loans/**, udhaar/** still credit the one generic "Bank Account" on the
// transaction date (src/app/api/invoices/route.ts and siblings — all off-limits to this agent).
// They are not retrofitted to a named BankAccount or a clearing date by this change. Only NEW
// entries made through this module's own screen get a named account and, for cheques, a real
// clearing date.
//
// accountId/matchedVoucherId/toBankAccountId below are bare pointers, not Prisma relations — the
// same convention LedgerEntry.accountId/invoiceId/loanId already use, so this feature needs no
// change to the Account or LedgerEntry models it addresses by id/voucherId.

model BankAccount {
  id             String    @id @default(cuid())
  firmId         String
  // The chart-of-accounts Account row this bank posts through: name "Bank - <name>", type asset,
  // self-provisioned on create (see src/app/api/bank/accounts/route.ts's own ensureAccount, same
  // shape as src/app/api/invoices/route.ts's).
  accountId      String?
  name           String // display name, e.g. "ICICI Current 4521" — must be unique per firm
  bankName       String?
  accountNumber  String?
  ifsc           String?
  branch         String?
  openingBalance Float     @default(0)
  openingDate    DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  firm           Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[]
  statementLines BankStatementLine[]

  @@unique([firmId, name])
  @@index([firmId])
}

model BankTransaction {
  id                 String    @id @default(cuid())
  firmId             String
  bankAccountId      String
  // deposit | withdrawal | transfer | cheque_in | cheque_out
  type               String
  // deposit/withdrawal: the other leg's ledger account name (e.g. "Cash in Hand"). Unused for
  // transfer (toBankAccountId instead) or cheque_* (always "Cheques in Transit").
  counterAccountName String?
  // transfer only. Bare pointer at another BankAccount.id — see file header.
  toBankAccountId    String?
  amount             Float
  // The date on the cheque, or the day cash/transfer physically moved.
  transactionDate    DateTime
  // The day it actually hit the bank. NULL until a cheque clears; equals transactionDate for
  // deposit/withdrawal/transfer, which post for real immediately.
  clearingDate       DateTime?
  // pending | cleared | bounced. deposit/withdrawal/transfer are always created 'cleared'; only
  // cheque_in/cheque_out start 'pending'.
  status             String    @default("cleared")
  chequeNumber       String?
  narration          String?   @db.Text
  // postVoucher()'s id for this row's own posting: the real bank leg for deposit/withdrawal/
  // transfer, or the "Cheques in Transit" leg while a cheque is still pending.
  voucherId          String?
  // Set only when a pending cheque clears: the voucher moving the money from Cheques in Transit
  // onto the real bank account, dated clearingDate.
  clearVoucherId     String?
  // Set only when a pending cheque bounces: reverseVoucher()'s output against voucherId above.
  // The original voucher is never edited — see src/lib/ledger.ts reverseVoucher().
  reversalVoucherId  String?
  userId             String?
  createdAt          DateTime  @default(now())

  firm        Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([firmId, bankAccountId])
  @@index([firmId, status])
}

model BankStatementLine {
  id               String    @id @default(cuid())
  firmId           String
  bankAccountId    String
  date             DateTime
  description      String    @db.Text
  debit            Float     @default(0) // withdrawal, per the bank's own statement
  credit           Float     @default(0) // deposit, per the bank's own statement
  reference        String?
  // Reconciliation is metadata about this IMPORTED row, never a mutation of the LedgerEntry it
  // matches — a bare pointer at LedgerEntry.voucherId (see file header); no LedgerEntry column is
  // ever written by this feature.
  matchedVoucherId String?
  matchedAt        DateTime?
  matchedBy        String? // userId who confirmed a manual match; NULL for an auto-match
  importBatch      String // groups one CSV import, so it can be reviewed/undone as a unit
  createdAt        DateTime  @default(now())

  firm        Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([firmId, bankAccountId, date])
  @@index([firmId, matchedVoucherId])
}
