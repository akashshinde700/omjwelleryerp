model Repair {
  id             String    @id @default(cuid())
  firmId         String
  repairNo       String
  customerId     String?
  customerName   String
  customerMobile String?
  karigarId      String?
  karigarName    String?
  userId         String?
  intakeDate     DateTime  @default(now())
  deliveryDate   DateTime?
  status         String    @default("received") // received | assigned | in_progress | ready | delivered | cancelled
  itemName       String
  itemDesc       String?   @db.Text
  problem        String?
  estimatedCost  Float     @default(0)
  finalCost      Float     @default(0)
  advancePaid    Float     @default(0)
  smsSent        Boolean   @default(false)
  note           String?   @db.Text
  // Set once, by POST /api/repairs/bill, when this job is billed into a real tax Invoice
  // (SAC 9987 service line — see that route). A plain pointer, not a Prisma relation, mirroring
  // Quotation.convertedInvoiceId — Invoice is owned by another agent and stays untouched here.
  // @unique doubles as the "billed only once" guard: the route claims a repair with a
